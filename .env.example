# Copy to .env.local and adjust. All values are optional; defaults are shown.
# Only NEXT_PUBLIC_* variables are read, and they are embedded at build time.

# Public origin used for canonical URLs, Open Graph, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Display name in the header, titles and metadata.
NEXT_PUBLIC_SITE_NAME=AgentFlow Learn

# Contact address shown in the footer (mailto link). Use a role address, not a personal one.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.org

# Optional link to the source repository (not shown when empty).
NEXT_PUBLIC_REPOSITORY_URL=

# Recommended: opt out of Next.js build telemetry on build machines.
NEXT_TELEMETRY_DISABLED=1
